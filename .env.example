APP_NAME="Sistem Data Perumahan"
APP_ENV=local
# PRODUKSI: APP_ENV=production, APP_DEBUG=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# URL foto storage untuk XAMPP subfolder: /perumahan-backend/public/storage
# Untuk php artisan serve atau virtual host, biarkan /storage.
STORAGE_URL=/storage

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Kosong bila web server melayani HTTPS langsung; isi IP/CIDR proxy bila ada
# proxy di depan; JANGAN memakai `*`.
TRUSTED_PROXIES=127.0.0.1,::1
# Produksi: host tambahan yang boleh mengakses aplikasi, pisahkan koma
# (mis. www.dprkp.cirebonkota.go.id). Host dari APP_URL selalu diizinkan;
# kosong berarti hanya host dari APP_URL yang diizinkan.
TRUSTED_HOSTS=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# detik; masa berlaku konfirmasi password untuk aksi admin berbahaya
AUTH_PASSWORD_TIMEOUT=900

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_perumahan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# SESSION_SECURE_COOKIE=true
# Aktifkan bila situs di HTTPS.
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Aplikasi tidak memakai antrean; di produksi cukup `sync`, tanpa worker.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Penghapusan laporan selesai; di server WAJIB isi tanggal deploy.
LAPORAN_HAPUS_OTOMATIS=true
LAPORAN_HAPUS_OTOMATIS_HARI=3
LAPORAN_HAPUS_OTOMATIS_SEJAK=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Produksi: ganti menjadi `smtp` agar email reset password terkirim; dengan
# `log`, tautan reset hanya tertulis di log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Wilayah default peta (lihat config/peta.php)
PETA_WILAYAH="Kota Cirebon"
PETA_LATITUDE=-6.7320
PETA_LONGITUDE=108.5523
PETA_ZOOM=13
PETA_ZOOM_DETAIL=17
PETA_LAT_MIN=-6.7900
PETA_LAT_MAX=-6.6900
PETA_LNG_MIN=108.5200
PETA_LNG_MAX=108.6000
# Server tile publik OpenStreetMap hanya untuk pemakaian ringan; untuk lalu lintas produksi gunakan penyedia tile berlangganan atau server tile sendiri.
PETA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (form lapor publik).
# Kosong = CAPTCHA nonaktif. Untuk produksi isi kunci ASLI dari dashboard
# Cloudflare (daftarkan domain pada widget). Kunci uji Cloudflare yang diawali
# pola khusus selalu lolos: jangan dipakai di produksi.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
